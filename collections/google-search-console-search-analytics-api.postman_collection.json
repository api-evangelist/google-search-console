                  "raw": "{\n  \"startDate\": \"2025-01-01\",\n  \"endDate\": \"2025-01-31\",\n  \"dimensions\": [\n    \"query\",\n    \"page\"\n  ],\n  \"type\": \"web\",\n  \"rowLimit\": 10,\n  \"startRow\": 0\n}",
                  "options": {
