  "item": [
    {
      "id": "6f989cdb-27dc-42e7-8aca-4d32e685c82f",
      "name": "Search Analytics",
      "description": {
        "content": "Query search traffic data for your site. Retrieve impressions, clicks, click-through rate, and average position grouped by dimensions such as query, page, country, device, search type, and date.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "bab0ab04-b1e1-441d-b87c-67dbcf150725",
          "name": "Google Search Console Query Search Analytics",
          "request": {
            "name": "Google Search Console Query Search Analytics",
            "description": {
              "content": "Query your search traffic data with filters and parameters that you define. Returns zero or more rows grouped by the row keys (dimensions) that you define. You must define a date range of one or more days. When date is one of the dimensions, any days without data are omitted from the result list. Data is available starting from the date the site was added to Search Console, and there is a processing delay of approximately 2-3 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webmasters",
                "v3",
                "sites",
                ":siteUrl",
                "searchAnalytics",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "siteUrl",
                  "description": "(Required) The site's URL, including protocol. For domain properties, use the format sc-domain:example.com. For URL-prefix properties, use the full URL (e.g., https://example.com/). The URL must be encoded."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"<date>\",\n  \"endDate\": \"<date>\",\n  \"dimensions\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"type\": \"web\",\n  \"dimensionFilterGroups\": [\n    {\n      \"groupType\": \"and\",\n      \"filters\": [\n        {\n          \"dimension\": \"<string>\",\n          \"expression\": \"<string>\",\n          \"operator\": \"equals\"\n        },\n        {\n          \"dimension\": \"<string>\",\n          \"expression\": \"<string>\",\n          \"operator\": \"equals\"\n        }\n      ]\n    },\n    {\n      \"groupType\": \"and\",\n      \"filters\": [\n        {\n          \"dimension\": \"<string>\",\n          \"expression\": \"<string>\",\n          \"operator\": \"equals\"\n        },\n        {\n          \"dimension\": \"<string>\",\n          \"expression\": \"<string>\",\n          \"operator\": \"equals\"\n        }\n      ]\n    }\n  ],\n  \"aggregationType\": \"auto\",\n  \"rowLimit\": 1000,\n  \"startRow\": 0,\n  \"dataState\": \"final\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "888bd0dc-2c97-40d2-a555-083ed800c782",
