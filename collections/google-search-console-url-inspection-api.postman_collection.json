      "id": "315c508d-8827-4ae8-bfc9-10893b83ce15",
      "name": "URL Inspection",
      "description": {
        "content": "Inspect individual URLs to retrieve detailed indexing, crawling, and serving information. Check whether a URL is indexed, view crawl details, mobile usability status, and rich results eligibility.",
        "type": "text/plain"
      },
      "item": [
