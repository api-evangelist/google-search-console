          "name": "Google Search Console Inspect a Url",
          "request": {
            "name": "Google Search Console Inspect a Url",
            "description": {
              "content": "Inspects a URL to retrieve detailed index status, crawl information, mobile usability findings, and rich results status. Returns the most recent indexing data Google has for the specified URL. The URL must belong to a property that the authenticated user has access to. This endpoint uses the v1 URL path, separate from the webmasters/v3 paths used by other Search Console endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "urlInspection",
                "index:inspect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
